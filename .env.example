# ==============================================================================
# PR REAL ESTATE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions: Copy this file to .env and insert your configuration details.
# DO NOT commit .env with real credentials to GitHub.

# Neon Serverless PostgreSQL Database Connection URL:
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Express API Port (Default: 3001)
PORT=3001

# Frontend API Base URL
VITE_API_URL=http://localhost:3001/api
